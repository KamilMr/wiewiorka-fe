node_modules/
.env
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
android/
ios/
_dev/
expo-env.d.ts

# Firebase credentials needed by the Android build.
!google-services.json
